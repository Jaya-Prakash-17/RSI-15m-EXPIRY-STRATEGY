# .graphignore — code-review-graph / antigravity
# Place at: PROJECT ROOT
# Purpose: Exclude non-code files so antigravity only graphs the 30 Python source files.
# Without this: it tries to tokenize thousands of CSVs, PNGs, and HTML reports → slow + expensive.

# ─── DATA FILES (biggest offender — DO NOT REMOVE) ───────────────────────────
# data/spot/ = 3 CSVs, ~50MB each (NIFTY/BANKNIFTY/SENSEX 2020-2026, 15min candles)
# data/derivatives/ = thousands of CSVs, one per option contract per year
data/spot/
data/derivatives/
data/**/*.csv
data/**/*.tmp
data/**/*.corrupted_*

# Runtime state files (JSON — not source code, changes every session)
data/bot_trades.json
data/strategy_state.json
data/pending_entries.json

# ─── REPORTS (generated output — not source code) ─────────────────────────────
# reports/ = HTML (5-10MB interactive Plotly), PNG (dashboards), JSON (trade dumps)
reports/
*.html
*.png
*.jpg
*.jpeg

# ─── LOGS ─────────────────────────────────────────────────────────────────────
logs/
*.log
oos_validation.log
backtest.log
live_trading.log

# ─── PYTHON ARTIFACTS ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.Python
*.egg-info/
dist/
build/
.eggs/

# ─── VIRTUAL ENVIRONMENTS ────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ─── SECRETS ─────────────────────────────────────────────────────────────────
.env
*.key
*.secret

# ─── IDE / OS NOISE ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
.agent/
.gemini/
Thumbs.db
*.swp
*.swo

# ─── TEST ARTIFACTS ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coverage

# ─── MARKDOWN DOCS (not code — no value for graph edges) ─────────────────────
# Comment this out if you want antigravity to understand architecture docs
# docs/
# *.md
# README.md

