# ================================================
# RSI Breakout Bot — Environment Variables
# ================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit the real .env file (it's in .gitignore)
# ================================================

# ──── Groww Broker API ────
# Get your API key from Groww Developer Console
GROWW_API_KEY=your_groww_api_jwt_token_here
GROWW_API_SECRET=your_groww_api_secret_here
# ──── Safety Mode ────
# To trade in paper (simulated) mode, set in config.yaml:
#   trading:
#     paper_trading: true
# Note: GROWW_MOCK_MODE was removed — use config.yaml paper_trading instead.

# ──── Telegram Notifications ────
# Telegram configuration has been moved to config.yaml under the 'telegram' section.
# See config.yaml for bot_token, chat_ids, and owner_id fields.
