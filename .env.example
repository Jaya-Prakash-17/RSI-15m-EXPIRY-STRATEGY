# ==========================================
# EXPIRY RSI 15M STRATEGY - Environment Vars
# ==========================================

# ── Groww Broker API Configuration ────────
# Your primary JWT access token for Groww API
GROWW_API_KEY="eyJraW..."

# Optional API Secret (if your integration requires it)
GROWW_API_SECRET="your_secret_here"

# Set to True/False to toggle mock responses. Keep False for Live.
GROWW_MOCK_MODE=False

# ── Telegram Notification Configuration ───
# Your trading bot's HTTP API token
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Comma-separated list of Chat IDs to broadcast alerts/reports to
TELEGRAM_CHAT_ID="***REDACTED_CHAT_IDS***"

# A specific Chat/User ID for critical admin-level interaction (e.g. Manual Kill Switch)
TELEGRAM_OWNER_ID="***REDACTED_OWNER_ID***"
